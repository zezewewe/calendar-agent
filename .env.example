# model-router (OpenAI-compatible)
ROUTER_URL=http://localhost:4000
ROUTER_API_KEY=
# Use a vision-capable alias from model-router/config.yaml. Images go to this model too.
EXTRACT_MODEL=vision-free

# Your timezone: used to resolve "tomorrow 3pm" and events with no zone.
TIMEZONE=Asia/Singapore

# Google Calendar
GOOGLE_CLIENT_SECRET_FILE=client_secret.json
GOOGLE_TOKEN_FILE=token.json
GOOGLE_CALENDAR_ID=primary

# Telegram bot (forward WhatsApp messages/screenshots here)
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user ids allowed to use the bot. Required.
TELEGRAM_ALLOWED_USERS=

STATE_DB=state.db

# HTTP channel (`calendar-agent serve`): one secondary calendar per user, under
# the single Google account above, shared to the user's Gmail so events show up
# in their own calendar. The caller's email comes from the ZeLabs gateway.
HTTP_HOST=127.0.0.1
HTTP_PORT=8099
CALENDAR_REGISTRY_DB=calendars.db
# ACL role granted to each user on their calendar: reader | writer | owner
SHARE_ROLE=writer
# Gateway route id (zelabs/routes.json) whose X-Zelabs-Identity secret we verify.
ZELABS_ROUTE_ID=calendar
# Master key for that verification. Leave unset to read ~/.ows/zelabs.identity.key
# (override the path with ZELABS_KEY_FILE). Run `calendar-agent serve --insecure`
# for local testing only.
ZELABS_IDENTITY_KEY=
ZELABS_KEY_FILE=
