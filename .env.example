# model-router (OpenAI-compatible)
ROUTER_URL=http://localhost:4000
ROUTER_API_KEY=
# Use a vision-capable alias from model-router/config.yaml. Images go to this model too.
EXTRACT_MODEL=vision-free

# Your timezone: used to resolve "tomorrow 3pm" and events with no zone.
TIMEZONE=Asia/Singapore

# Google Calendar
GOOGLE_CLIENT_SECRET_FILE=client_secret.json
GOOGLE_TOKEN_FILE=token.json
GOOGLE_CALENDAR_ID=primary

# Telegram bot (forward WhatsApp messages/screenshots here)
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user ids allowed to use the bot. Required.
TELEGRAM_ALLOWED_USERS=

STATE_DB=state.db
