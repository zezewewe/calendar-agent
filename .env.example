# model-router (OpenAI-compatible)
ROUTER_URL=http://localhost:4000
ROUTER_API_KEY=
# Use a vision-capable alias from model-router/config.yaml. Images go to this model too.
EXTRACT_MODEL=vision-free

# Your timezone: used to resolve "tomorrow 3pm" and events with no zone.
TIMEZONE=Asia/Singapore

# Calendar storage (only WebCalendar is supported).
CALENDAR_BACKEND=webcalendar

# WebCalendar MCP (Admin > System Settings > MCP Server; enable write access).
# The WebCalendar user's timezone preference must match TIMEZONE above.
WEBCALENDAR_PORT=8002
WEBCALENDAR_MCP_URL=http://localhost:8002/mcp.php
WEBCALENDAR_MCP_TOKEN=
# Used by the one-time installer and to sign in to the WebCalendar admin UI.
WEBCALENDAR_ADMIN_LOGIN=admin
WEBCALENDAR_ADMIN_PASSWORD=
WEBCALENDAR_AGENT_LOGIN=family
WEBCALENDAR_AGENT_PASSWORD=
# Optional display names for verified Telegram ids and HTTP email identities.
FAMILY_MEMBERS='{"123456789":"Alice","alice@example.com":"Alice"}'

# Telegram bot (forward WhatsApp messages/screenshots here)
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user ids allowed to use the bot. Required.
TELEGRAM_ALLOWED_USERS=
# Optional: the web calendar URL. When set, the bot's menu button opens it as a
# Telegram Mini App (interactive month/week view) without leaving the chat.
CALENDAR_WEB_URL=

STATE_DB=state.db

# MCP server (`calendar-agent mcp`): the identity it acts as on the shared calendar.
MCP_USER_ID=mcp

# HTTP channel (`calendar-agent serve`). Everyone uses the shared WebCalendar;
# the caller's email comes from the ZeLabs gateway.
HTTP_HOST=127.0.0.1
HTTP_PORT=8099
# Gateway route id (zelabs/routes.json) whose X-Zelabs-Identity secret we verify.
ZELABS_ROUTE_ID=calendar
# Master key for that verification. Leave unset to read ~/.ows/zelabs.identity.key
# (override the path with ZELABS_KEY_FILE). Run `calendar-agent serve --insecure`
# for local testing only.
ZELABS_IDENTITY_KEY=
ZELABS_KEY_FILE=
